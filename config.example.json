{
  "icsUrl": null,
  "manualEvents": [
    { "title": "Flight to Tokyo",       "start": "2026-06-15T08:00:00Z", "pinned": true },
    { "title": "Dentist appointment",   "start": "2026-06-10T14:30:00Z" },
    { "title": "Product launch",        "start": "2026-07-01T17:00:00Z" },
    { "title": "Birthday",              "start": "2026-09-12" },
    { "title": "Wedding anniversary",   "start": "2026-10-22" },
    { "title": "New Year's Eve party",  "start": "2026-12-31T20:00:00-05:00" },
    { "title": "Tax filing deadline",   "start": "2027-04-15" }
  ],
  "birthdays": [
    { "name": "Ada",   "month": 12, "day": 10, "year": 1815 },
    { "name": "Grace", "month": 12, "day": 9 },
    { "name": "Ada & Charles", "type": "anniversary", "label": "Wedding", "month": 7, "day": 8, "year": 1835 }
  ],
  "pinnedEvents": ["Birthday", "Flight"],
  "refreshSeconds": 60,
  "life": { "birthDate": "1990-01-15", "expectancyYears": 80 },
  "tailscaleHosts": [
    { "host": "myserver", "alias": "Home server" },
    { "host": "mybox.tailXXXXX.ts.net", "alias": "Office box" },
    { "host": "100.64.0.1", "alias": "By IP" }
  ],
  "analytics": {
    "title": "Analytics",
    "days": ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"],
    "locations": [
      {
        "name": "Studio A",
        "url": "https://studio-a.example.com/admin/analytics",
        "charts": [
          { "title": "Generation", "series": [
            { "label": "Batches", "values": [40, 52, 38, 61, 75, 58, 49] },
            { "label": "Photos",  "values": [320, 410, 300, 520, 640, 470, 390] }
          ]},
          { "title": "Prints", "series": [
            { "label": "Requested", "values": [18, 24, 15, 29, 33, 21, 19] },
            { "label": "Completed", "values": [17, 22, 15, 27, 31, 20, 18] }
          ]}
        ]
      },
      {
        "name": "Studio B",
        "url": "https://studio-b.example.com/admin/analytics",
        "charts": [
          { "title": "Generation", "series": [
            { "label": "Batches", "values": [22, 30, 19, 28, 41, 35, 27] },
            { "label": "Photos",  "values": [180, 250, 160, 240, 360, 300, 220] }
          ]},
          { "title": "Prints", "series": [
            { "label": "Requested", "values": [9, 14, 7, 12, 19, 15, 11] },
            { "label": "Completed", "values": [8, 13, 7, 11, 18, 14, 10] }
          ]}
        ]
      }
    ]
  },
  "liveLog": {
    "title": "Business Live Log",
    "windowHours": 48,
    "maxItems": 60,
    "auth": {
      "type": "walletSign",
      "nonceUrl": "https://api.example.com/auth/nonce",
      "loginUrl": "https://api.example.com/auth/login",
      "derive": {
        "usernameEnv": "LIVELOG_USERNAME",
        "passwordEnv": "LIVELOG_PASSWORD",
        "salt": "example-salt",
        "iterations": 10000
      },
      "signature": {
        "scheme": "eip712",
        "domain": { "name": "Example App", "version": "1", "chainId": "8453", "verifyingContract": "0xCcCCccccCCCCcCCCCCCcCcCccCcCCCcCcccccccC" },
        "primaryType": "Authentication",
        "types": {
          "Authentication": [
            { "name": "walletAddress", "type": "address" },
            { "name": "nonce", "type": "string" }
          ]
        },
        "message": { "walletAddress": "${walletAddress}", "nonce": "${nonce}" }
      },
      "origin": "https://admin.example.com",
      "extraBody": { "appSource": "dashboard" }
    },
    "stats": [
      {
        "api": "https://api.example.com/admin/signups",
        "params": { "date": "${today}" },
        "items": [{ "label": "Signups today", "path": "data.count" }]
      },
      {
        "api": "https://api.example.com/admin/subscription-metrics",
        "items": [
          { "label": "Active subs", "path": "data.activeCount" },
          { "label": "MRR", "path": "data.mrr", "format": "usd" },
          { "label": "Monthly", "path": "data.byPeriod[period=monthly].count" },
          { "label": "Annual", "path": "data.byPeriod[period=annual].count" }
        ]
      },
      {
        "api": "https://api.example.com/admin/revenue-summary",
        "params": { "date": "${today}", "status": "failed" },
        "items": [{ "label": "Failed pay today", "path": "data.total.count" }]
      }
    ],
    "sources": [
      {
        "id": "signups", "label": "Signup", "color": "#7aa2f7",
        "api": "https://api.example.com/admin/signups",
        "params": { "date": "${date}" },
        "dates": ["${today}", "${yesterday}"],
        "itemsPath": "data.accounts",
        "time": "createdAt",
        "title": "{username}",
        "detail": "{email} · {country}"
      },
      {
        "id": "purchases", "label": "Purchase", "color": "#34d399",
        "api": "https://api.example.com/admin/purchases",
        "params": { "from": "${ymdDaysAgo:2}", "status": "completed", "limit": 50 },
        "itemsPath": "data.transactions",
        "time": "createdAt",
        "require": [{ "field": "status", "in": ["completed"] }],
        "title": "{username}",
        "detail": "{email}",
        "value": "${amountUsd} · {credits} credits",
        "badges": [{ "field": "provider" }],
        "enrich": {
          "api": "https://api.example.com/admin/accounts/${value}",
          "key": "accountId",
          "fields": { "email": "data.email" },
          "ttlHours": 24,
          "max": 25
        }
      },
      {
        "id": "refunds", "label": "Refund", "color": "#ef4444",
        "api": "https://api.example.com/admin/purchases",
        "params": { "from": "${ymdDaysAgo:2}", "status": "refunded", "limit": 25 },
        "itemsPath": "data.transactions",
        "time": "createdAt",
        "require": [{ "field": "status", "in": ["refunded"] }],
        "title": "{username}",
        "detail": "refunded",
        "value": "-${amountUsd}"
      },
      {
        "id": "subscriptions", "label": "Subscribed", "color": "#a78bfa",
        "api": "https://api.example.com/admin/subscriptions",
        "params": { "limit": 30 },
        "itemsPath": "data.subscriptions",
        "time": "createdAt",
        "windowHours": 168,
        "title": "{username}",
        "badges": [
          { "field": "period", "map": { "monthly": "Monthly", "annual": "Annual" }, "color": "#7aa2f7" },
          { "field": "plan" }
        ],
        "collapse": [
          {
            "by": ["username", "provider"],
            "withinMinutes": 30,
            "when": { "field": "status", "equals": "expired" }
          }
        ],
        "variants": [
          { "when": [{ "field": "status", "equals": "trialing" }], "label": "Trial started", "color": "#f59e0b" },
          {
            "when": [
              { "field": "status", "in": ["active", "grace"] },
              { "field": "trialEndsAt", "nonNull": true }
            ],
            "label": "Trial converted", "color": "#34d399"
          },
          { "when": [{ "field": "status", "in": ["active", "grace"] }], "label": "Subscribed", "color": "#34d399" },
          { "when": [{ "field": "status", "in": ["cancelled", "expired"] }], "label": "Cancelled", "color": "#f87171" }
        ]
      }
    ]
  },
  "checklists": {
    "title": "Daily Checklists",
    "weekStart": "mon",
    "groups": ["Morning", "Lunch", "Dinner", "Nightly", "Weekly"],
    "items": [
      { "group": "Morning", "label": "Cold plunge" },
      { "group": "Morning", "label": "Supplements" },
      { "group": "Morning", "label": "10 air squats" },
      { "group": "Morning", "label": "Olive oil" },
      { "group": "Lunch",   "label": "Olive oil" },
      { "group": "Dinner",  "label": "Olive oil" },
      { "group": "Nightly", "label": "Supplements" },
      { "group": "Weekly",  "label": "Long run",  "repeat": "weekly" },
      { "group": "Weekly",  "label": "Meal prep", "repeat": ["sun"] },
      { "group": "Weekly",  "label": "Trash out", "repeat": ["mon", "thu"] }
    ]
  }
}
